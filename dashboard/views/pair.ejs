<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TOPFEROS MD - Connect</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#0d1117;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:#fff;
}

.container{
width:420px;
background:#161b22;
padding:25px;
border-radius:15px;
text-align:center;
box-shadow:0 0 20px rgba(0,255,0,.2);
}

img{
width:120px;
height:120px;
border-radius:50%;
margin-bottom:15px;
}

h2{
color:#00ff88;
margin-bottom:10px;
}

input{
width:100%;
padding:12px;
margin-top:15px;
border:none;
border-radius:8px;
background:#222;
color:#fff;
}

button{
width:100%;
padding:12px;
margin-top:15px;
border:none;
border-radius:8px;
background:#00ff88;
font-weight:bold;
cursor:pointer;
}

.qr-box{
margin-top:20px;
padding:20px;
border:2px dashed #00ff88;
border-radius:10px;
}

small{
color:#888;
}
</style>

</head>
<body>

<div class="container">

<img src="https://drive.google.com/uc?export=download&id=12f6XuXaVykA-OkR9ddTo5qxViUuwXcFI">

<h2>TOPFEROS MD</h2>

<p>Connect your WhatsApp account</p>

<input
type="text"
placeholder="509XXXXXXXX">

<button>
Generate Pair Code
</button>

<div class="qr-box">

<h3>QR Code</h3>

<p>QR Code will appear here.</p>

</div>

<br>

<small>
Powered by TOPFEROS TECH
</small>

</div>

</body>
</html>