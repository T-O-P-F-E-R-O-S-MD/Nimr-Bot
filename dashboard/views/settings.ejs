<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TOPFEROS MD - Settings</title>

<style>

body{
background:#0d1117;
font-family:Arial,sans-serif;
color:white;
padding:30px;
}

.container{
max-width:900px;
margin:auto;
}

.card{
background:#161b22;
padding:20px;
border-radius:15px;
margin-bottom:20px;
}

h1{
color:#00ff88;
}

.setting{
display:flex;
justify-content:space-between;
align-items:center;
padding:15px 0;
border-bottom:1px solid #333;
}

.switch{
width:50px;
height:25px;
}

button{
background:#00ff88;
border:none;
padding:12px 20px;
border-radius:10px;
font-weight:bold;
cursor:pointer;
}

</style>

</head>

<body>

<div class="container">

<h1>⚙️ TOPFEROS MD Settings</h1>

<div class="card">

<div class="setting">
<span>🤖 AI Chat</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>❤️ Auto React</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>📖 Auto Read</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>📞 Anti Call</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>⌨️ Fake Typing</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>🎤 Fake Recording</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>👀 Status Seen</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>💬 Status Reply</span>
<input class="switch" type="checkbox">
</div>

<div class="setting">
<span>💚 Always Online</span>
<input class="switch" type="checkbox">
</div>

<br>

<button>💾 Save Settings</button>

</div>

</div>

</body>
</html>