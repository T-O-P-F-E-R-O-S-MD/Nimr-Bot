<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= botName %> Login</title>

<link rel="stylesheet" href="/css/style.css">

<style>
body{
margin:0;
font-family:Arial,sans-serif;
background:#0d1117;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:#fff;
}

.card{
width:380px;
background:#161b22;
padding:30px;
border-radius:15px;
text-align:center;
box-shadow:0 0 20px rgba(0,255,0,.25);
}

img{
width:120px;
border-radius:50%;
margin-bottom:15px;
}

h1{
color:#00ff88;
}

button{
width:100%;
padding:12px;
border:none;
border-radius:10px;
background:#00ff88;
font-size:17px;
font-weight:bold;
cursor:pointer;
margin-top:15px;
}

small{
color:#999;
}
</style>

</head>
<body>

<div class="card">

<img src="https://drive.google.com/uc?export=download&id=12f6XuXaVykA-OkR9ddTo5qxViUuwXcFI">

<h1>TOPFEROS MD</h1>

<p>Powerful WhatsApp Multi Device Bot</p>

<a href="/pair">
<button>Connect WhatsApp</button>
</a>

<br><br>

<small>Version <%= version %></small>

</div>

</body>
</html>