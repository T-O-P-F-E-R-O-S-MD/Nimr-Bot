<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TOPFEROS MD Dashboard</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#0d1117;
color:#fff;
}

.sidebar{
position:fixed;
left:0;
top:0;
width:250px;
height:100vh;
background:#161b22;
padding:20px;
}

.sidebar h2{
color:#00ff88;
margin-bottom:30px;
}

.sidebar a{
display:block;
text-decoration:none;
color:#fff;
padding:12px;
margin:8px 0;
border-radius:8px;
transition:.3s;
}

.sidebar a:hover{
background:#00ff88;
color:#000;
}

.main{
margin-left:270px;
padding:30px;
}

.card{
background:#161b22;
padding:20px;
border-radius:15px;
margin-bottom:20px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.status{
font-size:20px;
color:#00ff88;
}

</style>

</head>

<body>

<div class="sidebar">

<h2>🤖 TOPFEROS MD</h2>

<a href="/dashboard">🏠 Dashboard</a>

<a href="/pair">📱 Connect</a>

<a href="/settings">⚙️ Settings</a>

<a href="/plugins">🔌 Plugins</a>

<a href="/users">👥 Users</a>

</div>

<div class="main">

<div class="card">

<h1>Welcome To TOPFEROS MD</h1>

<p class="status">

🟢 Bot Status : Offline

</p>

</div>

<div class="grid">

<div class="card">

<h3>Total Users</h3>

<h1>0</h1>

</div>

<div class="card">

<h3>Total Groups</h3>

<h1>0</h1>

</div>

<div class="card">

<h3>Plugins</h3>

<h1>0</h1>

</div>

<div class="card">

<h3>Commands</h3>

<h1>0</h1>

</div>

</div>

</div>

</body>

</html>